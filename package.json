{
  "name": "chronopolis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chronopolis: a third-person open-world time-travel adventure game, playable on desktop and mobile as a PWA.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "check:positions": "esbuild scripts/checkPositions.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkPositions.mjs --log-level=warning && node node_modules/.cache/checkPositions.mjs",
    "check:geometry": "esbuild scripts/checkGeometry.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkGeometry.mjs --log-level=warning && node node_modules/.cache/checkGeometry.mjs",
    "export:godot": "esbuild scripts/exportData.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/exportData.mjs --log-level=warning && node node_modules/.cache/exportData.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
